# WhatsApp floating button - phone number in international format (no + or spaces)
# Example: 254748583879 for Kenya, 447123456789 for UK
NEXT_PUBLIC_WHATSAPP_NUMBER=254748583879

# Public form is off unless this exact value is set at build time.
# NEXT_PUBLIC_CONTACT_FORM_DISABLED=enabled

# Same-origin PHP is the default. Do not set a different URL per environment.
# NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=/contact-handler.php

# Server-side path to JSON outside the web root. See docs/CONTACT-FORM-DEPLOYMENT.md
# TCC_CONTACT_CONFIG=/home/cpanel/tcc-private/contact.json
